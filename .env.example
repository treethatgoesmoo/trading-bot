DISCORD_TOKEN=your_discord_bot_token_here
ALERT_CHANNEL_ID=your_channel_id_here

# Legacy OHLCV sources (not the unified SPX index feed)
TWELVEDATA_API_KEY=your_twelvedata_key_here
FINNHUB_API_KEY=your_finnhub_key_here
# ThetaData v3 options/index access (never commit the real key)
THETADATA_API_KEY=your_thetadata_api_key

# Unified replacement (default). Overrides ALL legacy feature toggles below.
# Read docs/spx-notifications.md before deploying; preserve the Pi's real .env.
NOTIFICATION_MODE=spx
# REQUIRED for publication: replace 0 with a verified PRIVATE owner channel ID.
# No fallback to ALERT_CHANNEL_ID. 0 collects locally but sends no SPX notices.
SPX_CONTEXT_CHANNEL_ID=0
# Optional flow is session-wide but only inside the explicit audit window.
SPX_CONTEXT_FLOW_ENABLED=1
# Optional Yahoo SPY indicative VWAP/volume; not guaranteed real-time.
SPX_CONTEXT_PROXY_ENABLED=1
#SPX_CONTEXT_POLL_SECONDS=60
#SPX_CONTEXT_COOLDOWN_SECONDS=120
#SPX_CONTEXT_HEARTBEAT_MINUTES=30

# LEGACY ONLY: active only with explicit NOTIFICATION_MODE=legacy rollback.
# Feature toggles (1 = on, 0 = off)
ZERO_DTE_ENABLED=1
SWING_ENABLED=1
# Experimental paper-only SPX/SPXW turning-point watch (default off)
SPX_FLOW_ENABLED=0
#SPX_FLOW_ALERT_CHANNEL_ID=your_channel_id_here
# Shared flow sampler settings (also used by the quiet unified-mode cache):
#SPX_FLOW_POLL_SECONDS=60
#SPX_FLOW_LOOKBACK_MINUTES=5
#SPX_FLOW_STRIKE_RANGE=2
# Legacy full-watch alert cooldown only:
#SPX_FLOW_ALERT_COOLDOWN_MINUTES=10

# Opt-in subscription audit: explicit deployment start date, ET YYYY-MM-DD.
# Blank = audit/optional replacement flow OFF, NOT live SPX index collection.
# 30 calendar days; restart does not reset clock. Billing never stops automatically.
# See docs/research/theta-subscription-audit.md before enabling.
THETA_AUDIT_START_DATE=
THETA_AUDIT_DAYS=30
# LEGACY-ONLY quiet morning sampler if SPX_FLOW_ENABLED=0.
# NO effect in spx mode: use SPX_CONTEXT_FLOW_ENABLED there.
THETA_AUDIT_FLOW_ENABLED=1

# Remaining settings are for LEGACY mode, not the replacement SPX stream.
# Intraday (0DTE) watchlist
TICKERS=SPY

# Swing options feature — daily-timeframe 1-2 week option-buy signals
SWING_TICKERS=TSLA,AMD,GOOG,META
# Post swing alerts to a different channel (defaults to ALERT_CHANNEL_ID)
#SWING_ALERT_CHANNEL_ID=

# Intraday forecast cadence in minutes (1/5/15/30; default 15)
#FORECAST_INTERVAL_MINUTES=15
# Post the latest git change to the channel on (re)start (default on)
#STARTUP_CHANGELOG_ENABLED=1
# Nightly retune of forecast/swing indicator weights after close (default on)
#AUTO_TUNE_ENABLED=1
# Forecast contradiction guard: losing side at >=RATIO of the winning side's
# weight -> VOLATILE (yellow caution, with a lean) instead of a direction
#FORECAST_CONFLICT_RATIO=0.75
# Directional forecasts below this confidence are posted as VOLATILE instead
#FORECAST_VOLATILE_CONFIDENCE=65
# Grading deadband: |move| under this x interval ATR(14) grades as FLAT
# (also reused by the volume-spike watcher's grading)
#FORECAST_DEADBAND_ATR_MULT=0.25
# Forecast posting: "change" (post only when the read changes; default) or
# "always" (post every cycle). Change mode knobs below.
#FORECAST_POST_MODE=change
#FORECAST_REPOST_CONFIDENCE_DELTA=15
#FORECAST_HEARTBEAT_MINUTES=60
# VIX vote: 30-min VIX move must clear this many std devs of today's moves
#VIX_SIGNAL_MIN_Z=1.0
# Bollinger band touch alerts on 5m closes (default on; yfinance-only,
# no API budget). Fires once per touch; re-arms after a close back inside.
# 1m stream dropped 2026-08-12 (noise); touches are graded nightly.
#BB_WATCH_ENABLED=1
#BB_TICKERS=SPY
#BB_PERIOD=20
#BB_STD=2.0
#BB_ALERT_COOLDOWN_MINUTES=15
# Volume-spike alerts on 5m closes (default on; yfinance-only, no API
# budget). Fires once per spike (bar volume >= MULT x its trailing
# LOOKBACK-bar average); re-arms after a bar back under the threshold.
# Graded nightly like the BB watcher.
#VOLUME_WATCH_ENABLED=1
#VOLUME_WATCH_TICKERS=SPY
#VOLUME_SPIKE_LOOKBACK=20
#VOLUME_SPIKE_MULT=2.0
#VOLUME_ALERT_COOLDOWN_MINUTES=15
# Nightly 0DTE retune window in days of graded history (0 = all)
#AUTO_TUNE_DAYS=30
# Weight-tuning dampers: accuracy is shrunk toward 50% by this many coin-flip
# pseudo-samples, and a weight moves at most MAX_STEP per retune
#TUNED_WEIGHT_SHRINKAGE=50
#TUNED_WEIGHT_MAX_STEP=0.5
