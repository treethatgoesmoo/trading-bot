# Private SPY setups for manual SPX 0DTE execution. Never commit your real .env.
# Alpaca data credentials (paper account keys are supported).
DISCORD_TOKEN=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Explicit opt-in: both default OFF, including when upgrading an existing Pi.
# Collection makes Alpaca data requests. Publication permits Discord alerts.
COLLECTION_ENABLED=false
PUBLICATION_ENABLED=false

# Required private owner channel. 0 prevents publication; no public fallback.
SPX_CHANNEL_ID=0
# Completed-minute polling, integer 30..60 seconds; default 60.
SPX_POLL_SECONDS=60

# Optional request metadata only. Keep the ORIGINAL audit start date on upgrade.
# Blank/invalid/expired window disables metadata, NOT collection or vendor billing.
MARKET_DATA_AUDIT_START_DATE=
MARKET_DATA_AUDIT_DAYS=30

# Only the keys above are used. Old SPX_CONTEXT_* aliases are no longer read.
# Preserve existing credentials and the original audit date when upgrading.
