DISCORD_TOKEN=your_discord_bot_token_here
ALERT_CHANNEL_ID=your_channel_id_here

# Primary data sources (leave blank to use yfinance as fallback)
TWELVEDATA_API_KEY=your_twelvedata_key_here
FINNHUB_API_KEY=your_finnhub_key_here

# Feature toggles (1 = on, 0 = off)
ZERO_DTE_ENABLED=1
SWING_ENABLED=1

# Intraday (0DTE) watchlist
TICKERS=SPY

# Swing options feature — daily-timeframe 1-2 week option-buy signals
SWING_TICKERS=TSLA,AMD,GOOG,META
# Post swing alerts to a different channel (defaults to ALERT_CHANNEL_ID)
#SWING_ALERT_CHANNEL_ID=

# 0DTE SPX option range capture: track one ATM call + put per day and post
# the effective premium min/max at the close (default on)
#SPX_OPTIONS_ENABLED=1
# Underlying chain to track (^SPX; set to SPY for the ETF chain)
#SPX_OPTIONS_TICKER=^SPX
# ORB opening-range window (minutes) and measured-move target multiple —
# breakout targets sit MULT x the range height beyond the range and price
# each side's projected max
#SPX_OPTIONS_ORB_MINUTES=15
#SPX_OPTIONS_ORB_TARGET_MULT=1.0
# Minutes after the open to pick the contracts (defaults to the ORB window)
# and minutes between premium samples
#SPX_OPTIONS_PICK_DELAY_MINUTES=15
#SPX_OPTIONS_SAMPLE_MINUTES=5

# Intraday forecast cadence in minutes (1/5/15/30; default 15)
#FORECAST_INTERVAL_MINUTES=15
# Morning day forecast (direction + projected high/low) at ~9:35 ET (default on)
#DAY_FORECAST_ENABLED=1
# Post the latest git change to the channel on (re)start (default on)
#STARTUP_CHANGELOG_ENABLED=1
# Nightly retune of forecast/swing indicator weights after close (default on)
#AUTO_TUNE_ENABLED=1
# Min minutes between identical RSI alerts (anti-spam; default 30)
#RSI_ALERT_COOLDOWN_MINUTES=30
# Forecast contradiction guard: losing side at >=RATIO of the winning side's
# weight -> VOLATILE (yellow caution, with a lean) instead of a direction
#FORECAST_CONFLICT_RATIO=0.75
# Directional forecasts below this confidence are posted as VOLATILE instead
#FORECAST_VOLATILE_CONFIDENCE=65
# Companion 5-min forecast posted every 5 minutes (default on)
#FORECAST_5M_ENABLED=1
# Grading deadband: |move| under this x interval ATR(14) grades as FLAT
#FORECAST_DEADBAND_ATR_MULT=0.25
# Forecast posting: "change" (post only when the read changes; default) or
# "always" (post every cycle). Change mode knobs below.
#FORECAST_POST_MODE=change
#FORECAST_REPOST_CONFIDENCE_DELTA=15
#FORECAST_HEARTBEAT_MINUTES=60
# VIX vote: 30-min VIX move must clear this many std devs of today's moves
#VIX_SIGNAL_MIN_Z=1.0
# Bollinger band touch alerts on 1m+5m closes (default on; yfinance-only,
# no API budget). Fires once per touch; re-arms after a close back inside.
#BB_WATCH_ENABLED=1
#BB_TICKERS=SPY
#BB_PERIOD=20
#BB_STD=2.0
#BB_ALERT_COOLDOWN_MINUTES=15
# Nightly 0DTE retune window in days of graded history (0 = all)
#AUTO_TUNE_DAYS=30
# Weight-tuning dampers: accuracy is shrunk toward 50% by this many coin-flip
# pseudo-samples, and a weight moves at most MAX_STEP per retune
#TUNED_WEIGHT_SHRINKAGE=50
#TUNED_WEIGHT_MAX_STEP=0.5
