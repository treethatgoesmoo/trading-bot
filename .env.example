DISCORD_TOKEN=your_discord_bot_token_here
# ThetaData v3 index access; never commit the real key. Python 3.12+ required.
THETADATA_API_KEY=your_thetadata_api_key

# Sole live stream: SPX 1m/5m/15m Bollinger events + RSI/MACD context.
# Keep this existing key when upgrading the Pi. No fallback to ALERT_CHANNEL_ID.
# REQUIRED for publication: a verified PRIVATE owner channel. 0 = local collection only.
SPX_CONTEXT_CHANNEL_ID=0
SPX_CONTEXT_POLL_SECONDS=60
# Rules are fixed/versioned: BB(20,2), RSI(14), MACD(12,26,9).
# No heartbeat, legacy mode, SPY proxy, options flow, or AI service is installed.

# Optional bounded request telemetry and quiet frozen ORB audit mirrors.
# Use the original fixed ET start date; do not reset it on restart/upgrades.
# Blank = mirrors/telemetry off, NOT index collection or vendor billing off.
THETA_AUDIT_START_DATE=
THETA_AUDIT_DAYS=30

# Existing tracked-history housekeeping (never commits licensed data).
GIT_AUTOCOMMIT_ENABLED=1
GIT_AUTOCOMMIT_PUSH=1

# See docs/bb-notifications.md. Preserve an existing .env when upgrading.
# Retired notification flags may be removed; they cannot enable old streams.
