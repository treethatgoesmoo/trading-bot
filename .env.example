# Private SPX Discord state alerts. Never commit your real .env.
DISCORD_TOKEN=
THETADATA_API_KEY=

# Explicit opt-in: both default OFF, including when upgrading an existing Pi.
# Collection makes paid-provider requests. Publication permits Discord alerts.
COLLECTION_ENABLED=false
PUBLICATION_ENABLED=false

# Required private owner channel. 0 prevents publication; no public fallback.
SPX_CHANNEL_ID=0
# Completed-minute polling, integer 30..60 seconds; default 60.
SPX_POLL_SECONDS=60

# Optional request metadata only. Keep the ORIGINAL audit start date on upgrade.
# Blank/invalid/expired window disables metadata, NOT collection or vendor billing.
THETA_AUDIT_START_DATE=
THETA_AUDIT_DAYS=30

# Migration aliases only: SPX_CONTEXT_CHANNEL_ID / SPX_CONTEXT_POLL_SECONDS are
# read if the corresponding new key is absent. Prefer the names above.
# All old strategy/notification/git flags are ignored; no legacy mode exists.
